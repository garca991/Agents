# Plantilla de variables de entorno.
# Copia este archivo a `.env.development` y rellena los valores.

# OpenRouter (modelos de chat y embeddings): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Secreto con el que se firman/verifican los JWT del login.
# Usa cualquier cadena larga y aleatoria, por ejemplo: cambiacontraseña1234567890
MASTRA_JWT_SECRET=
